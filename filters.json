    "stop_symbols": [
      "➡",
      "⭐",
      "🔥",
      "❗",
      "❌",
      "✅"
    ],
    "regex_patterns": [
      "^\\d{1,2}:\\d{2}\\s*$",
      "^\\d{3,4}\\s*$",
      "^\\d{1,2}\\.\\d{2}\\.\\s*$",
      "^\\d{1,2}\\s*(час|ч|минут|мин|\\.)"
    ]
  },
  "source_specific_filters": {
    "47news.ru": {
      "stop_words": ["47news", "новости Ленобласти"],
      "stop_symbols": [],
      "regex_patterns": []
    },
    "Фонтанка": {
      "stop_words": ["Фонтанка", "Санкт-Петербург"],
      "stop_symbols": [],
      "regex_patterns": []
    }
  }
}
