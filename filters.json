{
  "global_filters": {
    "stop_words": [
      "читать дальше",
      "подробнее", 
      "комментарии",
      "фото",
      "видео",
      "источник",
      "новости",
      "главное",
      "смотрите также",
      "реклама",
      "афиша",
      "расписание",
